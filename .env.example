STEAM_API_KEY=
STEAM_LANGUAGE=english
STEAM_CONCURRENCY=2
STEAM_BATCH_DELAY_MS=350
STEAM_RETRY_COUNT=5
STEAM_MAX_GAMES_PER_RUN=20
STEAM_RATE_LIMIT_COOLDOWN_SECONDS=1800
STEAM_FAILURES_BEFORE_SKIP=1
STEAM_UNAVAILABLE_RETRY_SECONDS=86400
RARITY_CACHE_MAX_AGE_SECONDS=604800

# Console importer (optional, outside the Steam sync)
# Obtain NPSSO from your own signed-in PlayStation account; treat it as a password.
PSN_NPSSO=
# Numeric PSN account IDs of the players, or "me" for the account used to authenticate.
PSN_PETER_ACCOUNT_ID=
PSN_FLORIAN_ACCOUNT_ID=
# Prefer human-readable Online IDs when account IDs are unknown.
PSN_PETER_ONLINE_ID=
PSN_FLORIAN_ONLINE_ID=
# API key from https://xbl.io/, and Xbox XUIDs (numeric, not gamertags).
OPENXBL_API_KEY=
XBOX_PETER_XUID=
XBOX_FLORIAN_XUID=
# Prefer gamertags if XUIDs are unknown.
XBOX_PETER_GAMERTAG=
XBOX_FLORIAN_GAMERTAG=
# Delay between PlayStation requests.
CONSOLE_IMPORT_DELAY_MS=350
